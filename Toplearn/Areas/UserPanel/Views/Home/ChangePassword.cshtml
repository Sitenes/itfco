@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

@model Toplearn.Core.DTOs.UserVM.ChangePasswordViewModel
@{
    ViewData["Title"] = Localizer["ChangePasswordTitle"];
}

<main class="client-page">
    <div class="container-content">
        <header><h2>@Localizer["ChangePasswordHeader"]</h2></header>
        <div class="form-layer">
            <form action="ChangePassword" method="post">
                <input type="hidden" asp-for="UserId" class="form-control" aria-describedby="userId" />

                <div class="input-group">
                    <span class="input-group-addon"><i class="zmdi zmdi-lock"></i></span>
                    <input type="password" asp-for="OldPassword" class="form-control" placeholder="@Localizer["OldPasswordPlaceholder"]" />
                </div>
                <span asp-validation-for="OldPassword" class="text-danger"></span>

                <div class="input-group">
                    <span class="input-group-addon"><i class="zmdi zmdi-lock-outline"></i></span>
                    <input type="password" asp-for="Password" class="form-control" placeholder="@Localizer["NewPasswordPlaceholder"]" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>

                <div class="input-group">
                    <span class="input-group-addon"><i class="zmdi zmdi-lock-outline"></i></span>
                    <input type="password" asp-for="RePassword" class="form-control" placeholder="@Localizer["RepeatPasswordPlaceholder"]" />
                </div>
                <span asp-validation-for="RePassword" class="text-danger"></span>

                <div class="input-group">
                    <button class="theme-btn btn-style-one">@Localizer["SubmitChangesButton"]</button>
                </div>
            </form>
        </div>
    </div>
</main>
