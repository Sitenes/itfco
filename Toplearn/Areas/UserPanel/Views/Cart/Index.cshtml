@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

@model Toplearn.DataLayer.Entities.Courses.Cart
@using Toplearn.Core.Convertors
@using System.Globalization
@{
    ViewData["Title"] = Localizer["Cart"];
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}

<!--Cart Section-->
<section class="cart-section">
    <div class="auto-container">
        <!--Cart Outer-->
        <div class="cart-outer">
            <div class="table-outer">
                <table class="cart-table">
                    <thead class="cart-header">
                        <tr>
                            <th>@Localizer["Preview"]</th>
                            <th class="prod-column">@Localizer["Product"]</th>
                            <th class="price">@Localizer["Price"]</th>
                            <th>@Localizer["Quantity"]</th>
                            <th>@Localizer["Total"]</th>
                            <th>&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CourseCarts != null)
                        {
                            foreach (var product in Model.CourseCarts)
                            {
                                <tr>
                                    <td class="prod-column">
                                        <div class="column-box">
                                            <figure class="prod-thumb"><a href="/product/@(product.CourseId)"><img src="/CourseRoot/Image/@(product.Course.Image)" alt="@(product.Course.TitlePersian)"></a></figure>
                                        </div>
                                    </td>
                                    <td><h4 class="prod-title">@(product.Course.TitlePersian)</h4></td>
                                    <td class="sub-total">@(((currentCulture == "fa" ? product.Course.Price : product.Course.PriceDollar)).ToString("N0")) @Localizer["Tooman"]</td>
                                    <td class="qty"><div class="item-quantity"><input disabled class="quantity-spinner" type="text" value="@(product.Count)" name="quantity"></div></td>
                                    <td class="total">@(((currentCulture == "fa" ? product.Course.Price : product.Course.PriceDollar) * product.Count).ToString("N0")) @Localizer["Tooman"]</td>
                                    <td><a href="/api/Cart/RemoveProductByUser/@(product.CourseId)/@(Model.Id)" class="remove-btn"><span class="fa fa-2x fa-remove"></span></a></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row justify-content-between">
            <div class="column pull-right col-lg-12 col-md-12 col-sm-12">
                <!--Totals Table-->
                <ul class="totals-table">
                    <li><h3>@Localizer["CartTotals"]</h3></li>
                    @if (Model.CourseCarts != null)
                    {
                        <li class="clearfix total">
                            <span class="col">@Localizer["TotalWithoutDiscount"]</span>
                            <span class="col price">@(Model.GetPrice(currentCulture != "fa")) @Localizer["Tooman"]</span>
                        </li>
                        <li class="clearfix total">
                            <span class="col">@Localizer["TotalWithDiscount"]</span>
                            <span class="col price">@(Model.GetPriceWithDiscount(currentCulture != "fa").ToString("#,###")) @Localizer["Tooman"]</span>
                        </li>
                        <li class="text-right row">
                            <div class="col-md-6 col-lg-6 col-sm-12">
                                <a href="/Userpanel/Cart/Checkout" class="theme-btn proceed-btn">@Localizer["ProceedToCheckout"]</a>
                            </div>
                            <div class="col-md-6 col-lg-6 col-sm-12">
                                <a href="/product" class="pull-left theme-btn proceed-btn">@Localizer["ViewOtherProducts"]</a>
                            </div>
                            <div class="clearfix col-sm-12" style="display:flex;justify-content:center;margin-top:30px;">
                                <div class="">
                                    <div class="apply-coupon clearfix">
                                        <form asp-action="ApplyCoupon" method="post">
                                            <input type="hidden" name="cartId" value="@Model.Id">
                                            <div class="form-group clearfix">
                                                <input type="text" name="code" value="" placeholder="@Localizer["CouponCode"]">
                                                @if (ViewData["codeSuccess"] as bool? == true)
                                                {
                                                    <h3 class="badge badge-success text-light">@Localizer["CouponAppliedSuccess"]</h3>
                                                }
                                                else if (ViewData["codeSuccess"] as bool? == false)
                                                {
                                                    <h3 class="badge badge-danger text-light">@Localizer["CouponInvalid"]</h3>
                                                }
                                            </div>
                                            <div class="form-group clearfix">
                                                <button type="submit" class="theme-btn coupon-btn">@Localizer["ApplyCoupon"]</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
<!--End Cart Section-->
