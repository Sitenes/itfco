@model Toplearn.DataLayer.Entities.Courses.Cart
@using Toplearn.Core.Convertors
@{
    ViewData["Title"] = "سبد خرید ";
}

<!--Cart Section-->
<section class="cart-section">
    <div class="auto-container">
        <!--Cart Outer-->
        <div class="cart-outer">
            <div class="table-outer">
                <table class="cart-table">
                    <thead class="cart-header">
                        <tr>
                            <th>Preview</th>
                            <th class="prod-column">product</th>
                            <th class="price">Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CourseCarts != null)
                            @foreach (var product in Model.CourseCarts)
                            {
                                <tr>
                                    <td class="prod-column">
                                        <div class="column-box">
                                            <figure class="prod-thumb"><a href="/product/@(product.CourseId)"><img src="/CourseRoot/Image/@(product.Course.Image)" alt="@(product.Course.Title)"></a></figure>
                                        </div>
                                    </td>
                                    <td><h4 class="prod-title">@(product.Course.Title)</h4></td>
                                    <td class="sub-total">@(product.Course.Price)</td>
                                    <td class="qty"><div class="item-quantity"><input disabled class="quantity-spinner" type="text" value="@(product.Count)" name="quantity"></div></td>
                                    <td class="total">@(product.Course.Price)</td>
                                    <td><a href="/api/Cart/RemoveProductByUser/@(product.CourseId)/@(Model.Id)" class="remove-btn"><span class="fa fa-2x fa-remove"></span></a></td>
                                </tr>
                            }
                    </tbody>
                </table>
            </div>


        </div>

        <div class="row justify-content-between">
            
            <div class="column pull-right col-lg-12 col-md-12 col-sm-12">
                <!--Totals Table-->
                <ul class="totals-table">
                    <li><h3>Cart Totals</h3></li>
                    @if (Model.CourseCarts != null)
                    {
                        <li class="clearfix total"><span class="col">Total with out discount</span><span class="col price">@(Model.GetPrice(false).ToString("#,###")) تومان</span></li>
                        <li class="clearfix total"><span class="col">Total</span><span class="col price">@(Model.GetPriceWithDiscount(false).ToString("#,###")) تومان</span></li>
                        <li class="text-right row">
                            <div class=" col-md-6  col-lg-6 col-sm-12">
                                <a href="/Userpanel/Cart/Checkout" class="theme-btn proceed-btn">Proceed to Checkout</a>
                            </div>
                            <div class=" col-md-6  col-lg-6 col-sm-12">
                                <a href="/product" class="pull-left theme-btn proceed-btn">View other products</a>
                            </div>
                            <div class="clearfix col-sm-12" style="display:flex;justify-content:center;margin-top:30px;">
                                <div class="">
                                    <div class="apply-coupon clearfix">
                                        <form asp-action="ApplyCoupon" method="post">
                                            <input type="hidden" name="cartId" value="@Model.Id">
                                            <div class="form-group clearfix">
                                                <input type="text" name="code" value="" placeholder="Coupon Code">
                                                @if (ViewData["codeSuccess"] as bool? == true)
                                                {
                                                    <h3 class="badge badge-success text-light">کد تخفیف با موفقیت اعمال شد !</h3>
                                                }
                                                else if (ViewData["codeSuccess"] as bool? == false)
                                                {
                                                    <h3 class="badge badge-danger  text-light">کد تخفیف معتبر نمی باشد</h3>
                                                }
                                            </div>
                                            <div class="form-group clearfix">
                                                <button type="submit" class="theme-btn coupon-btn">Apply Coupon</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                                @*  <div class="pull-right">
                            <button type="button" class="theme-btn cart-btn">update cart</button>
                            </div> *@
                            </div>

                        </li>


                    }
                </ul>
            </div>
        </div>
    </div>
</section>
<!--End Cart Section-->