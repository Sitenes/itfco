@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer
@using Toplearn.DataLayer.Entities.Courses
@using Toplearn.Core.Convertors
@model Cart
@using System.Globalization

@{
    ViewData["Title"] = Localizer["Billing Details"];
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}

<form method="get" asp-action="Payment" asp-controller="Cart">
    <div class="checkout-form container">
        <div class="row clearfix">
            <div class="column col-lg-12 col-md-12 col-sm-12">
                <div class="sec-title">
                    <h3>@Localizer["Billing Details"]</h3>
                </div>

                <div class="row clearfix">
                    <div class="form-group col-md-6 col-sm-12">
                        <div class="field-label">@Localizer["First Name"] <sup>*</sup></div>
                        <input type="text" required asp-for="FirstName" placeholder="">
                    </div>

                    <div class="form-group col-md-6 col-sm-12">
                        <div class="field-label">@Localizer["Last Name"] <sup>*</sup></div>
                        <input type="text" required asp-for="LastName" placeholder="">
                    </div>

                    <div class="form-group col-md-12 col-sm-12">
                        <div class="field-label">@Localizer["Company Name"]</div>
                        <input type="text" asp-for="CompanyName" placeholder="">
                    </div>

                    <div class="form-group col-md-6 col-sm-12">
                        <div class="field-label">@Localizer["Email Address"]</div>
                        <input type="text" asp-for="Email" placeholder="">
                    </div>

                    <div class="form-group col-md-6 col-sm-12">
                        <div class="field-label">@Localizer["Phone"]</div>
                        <input type="text" asp-for="Phone" placeholder="">
                    </div>

                    <div class="form-group col-md-12 col-sm-12">
                        <div class="field-label">@Localizer["Country"]</div>
                        <input type="text" asp-for="Country" placeholder="">
                    </div>

                    <div class="form-group col-md-12 col-sm-12">
                        <div class="field-label">@Localizer["Address"] <sup>*</sup></div>
                        <input type="text" required asp-for="Address" placeholder="@Localizer["Street address"]">
                    </div>

                    <div class="form-group col-md-12 col-sm-12">
                        <input type="text" asp-for="AddressAdditional" placeholder="@Localizer["Apartment,suite,unit etc. (optional)"]">
                    </div>

                    <div class="form-group col-md-12 col-sm-12">
                        <div class="field-label">@Localizer["Town/City"]</div>
                        <input type="text" asp-for="City" placeholder="">
                    </div>

                    <div class="form-group col-md-6 col-sm-12">
                        <div class="field-label">@Localizer["State / County"]</div>
                        <input type="text" asp-for="State" placeholder="">
                    </div>

                    <div class="form-group col-md-6 col-sm-12">
                        <div class="field-label">@Localizer["Postcode/ ZIP"]</div>
                        <input type="text" asp-for="Postcode" placeholder="">
                    </div>

                    <div class="form-group col-md-12 col-sm-12">
                        <div class="field-label">@Localizer["Extra Notes"]</div>
                        <input type="text" asp-for="Notes" placeholder="">
                    </div>

                    <h5 class="form-group col-md-12 col-sm-12">
                        <span>@Localizer["شماره کارت بانک مسکن : 6280231536648826"]</span>
                        <br />
                        <br />
                        <span>@Localizer["شبا کارت : IR570140040000151100937771"]</span>
                    </h5>
                </div>
            </div>
        </div>
    </div>

    <div class="payment-box">
        <div class="upper-box">
            <div class="lower-box text-right container" style="margin-top:0px">
                <button type="submit" class="theme-btn btn-style-one">@Localizer["Place Order"]</button>
            </div>
        </div>
    </div>
</form>

<section>
    <div class="auto-container">
        <div class="cart-outer">
            <div class="table-outer">
                <table class="cart-table">
                    <thead class="cart-header">
                        <tr>
                            <th>@Localizer["Preview"]</th>
                            <th class="prod-column">@Localizer["product"]</th>
                            <th class="price">@Localizer["Price"]</th>
                            <th>@Localizer["Quantity"]</th>
                            <th>@Localizer["Total"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CourseCarts != null)
                        {
                            foreach (var product in Model.CourseCarts)
                            {
                                <tr>
                                    <td class="prod-column">
                                        <div class="column-box">
                                            <figure class="prod-thumb">
                                                <a href="/product/@(product.CourseId)">
                                                    <img src="/CourseRoot/Image/@(product.Course.Image)" alt="@(product.Course.Title)">
                                                </a>
                                            </figure>
                                        </div>
                                    </td>
                                    <td><h4 class="prod-title">@(product.Course.Title)</h4></td>
                                    <td class="sub-total">@(((currentCulture == "fa" ? product.Course.Price : product.Course.PriceDollar)).ToString("N0")) @Localizer["Tooman"]</td>
                                    <td class="qty"><div class="item-quantity"><input disabled class="quantity-spinner" type="text" value="@(product.Count)" name="quantity"></div></td>
                                    <td class="total">@(((currentCulture == "fa" ? product.Course.Price : product.Course.PriceDollar) * product.Count).ToString("N0")) @Localizer["Tooman"]</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
