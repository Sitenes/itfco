@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer
@using Toplearn.DataLayer.Entities.Courses;
@model List<Cart>
@using System.Globalization

@{
    ViewData["Title"] = @Localizer["OrderList"];

    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
<main>
    <div class="container">
        <div class="user-account">
            <div class="row">
                <partial name="SideBarPartial" />
                <div class="col-md-9 col-sm-8 col-xs-12">
                    <section class="user-account-content">
                        <header><h1>@Localizer["OrderList"]</h1></header>
                        <div class="inner">
                            <!--Cart Section-->
                            <section>
                                <div class="auto-container">
                                    <!--Cart Outer-->
                                    <div class="cart-outer">
                                        <div class="table-outer">
                                            <table class="cart-table">
                                                <thead class="cart-header">
                                                    <tr>
                                                        <th>@Localizer["Row"]</th>
                                                        <th>@Localizer["TrackingCode"]</th>
                                                        <th>@Localizer["TotalPrice"]</th>
                                                        <th>@Localizer["ItemCount"]</th>
                                                        <th>@Localizer["Status"]</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        int rowNum = 0;
                                                    }
                                                    @if (Model != null)
                                                    {
                                                        foreach (var courseItem in Model)
                                                        {
                                                            rowNum++;
                                                            <tr class="gradeA odd">
                                                                <td>@rowNum</td>
                                                                <td>@courseItem.Id</td>
                                                                <td class="center ">@courseItem.CourseCarts?.Sum(x => currentCulture == "fa" ? x.Course?.Price : x.Course?.PriceDollar))</td>
                                                                <td class="center ">@courseItem.CourseCarts?.Count()</td>
                                                                <td class="center ">
                                                                    @if (courseItem.IsPaid)
                                                                    {
                                                                        <span class="badge alert-success">
                                                                            <i class="zmdi zmdi-check"></i> @Localizer["Paid"]
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge alert-warning">
                                                                            <i class="zmdi zmdi-close"></i> @Localizer["NotPaid"]
                                                                        </span>
                                                                    }
                                                                </td>
                                                                <td class="center tooltip-demo">
                                                                    <a class="btn btn-outline-primary" href="/UserPanel/Cart?cartId=@courseItem.Id">
                                                                        <i class="fa fa-info"></i>
                                                                    </a>
                                                                    <a class="btn btn-outline-danger" data-toggle="modal" data-target="#DeleteModal@(courseItem.Id)">
                                                                        <i class="fa fa-remove"></i>
                                                                    </a>
                                                                    <div class="modal fade" id="DeleteModal@(courseItem.Id)" tabindex="-1" role="dialog" aria-labelledby="DeleteModalLabel" aria-hidden="true" style="display: none;">
                                                                        <div class="modal-dialog">
                                                                            <div class="modal-content">
                                                                                <div class="modal-header alert-warning">
                                                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                                        <span aria-hidden="true">&times;</span>
                                                                                    </button>
                                                                                    <h5 class="modal-title h2" id="exampleModalLabel">
                                                                                        @Localizer["ConfirmDeleteCart"] @(courseItem.UserCreator?.UserName)
                                                                                    </h5>
                                                                                </div>
                                                                                <div class="modal-footer">
                                                                                    <button type="button" class="btn btn-default btn-outline" data-dismiss="modal" aria-label="Close">
                                                                                        @Localizer["Cancel"]
                                                                                    </button>
                                                                                    <a class="btn btn-danger" style="min-width:100px" href="/api/Cart/DeleteByUser/@(courseItem.Id)">
                                                                                        @Localizer["Delete"]
                                                                                    </a>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }

                                                    @*  @if (Model.CourseCarts != null)
                                                    @foreach (var product in Model.CourseCarts)
                                                    {
                                                    <tr>
                                                    <td class="prod-column">
                                                    <div class="column-box">
                                                    <figure class="prod-thumb"><a href="/product/@(product.CourseId)"><img src="/CourseRoot/Image/@(product.Course.Image)" alt="@(product.Course.Title)"></a></figure>
                                                    </div>
                                                    </td>
                                                    <td><h4 class="prod-title">@(product.Course.Title)</h4></td>
                                                    <td class="sub-total">@(product.Course.Price)</td>
                                                    <td class="qty"><div class="item-quantity"><input disabled class="quantity-spinner" type="text" value="@(product.Count)" name="quantity"></div></td>
                                                    <td class="total">@(product.Course.Price)</td>
                                                    <td><a href="/api/Cart/RemoveProduct/@(product.CourseId)" class="remove-btn"><span class="fa fa-2x fa-remove"></span></a></td>
                                                    </tr>
                                                    } *@
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            <!--End Cart Section-->
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</main>
