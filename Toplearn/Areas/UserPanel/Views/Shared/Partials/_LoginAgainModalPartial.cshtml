@model EmailOnlyViewModel
@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

<script>
    $(document).ready(function () {
        setTimeout(function () { 
            $('#exampleModal').modal('show'); 
            setTimeout(function () { 
                $('#exampleModal').modal('hide'); 
                location.replace("/Logout"); 
            }, 20000); 
        }, 500);
    });
</script>

<!-- Modal -->
<div class="modal fade " id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header alert-success">
                <h5 class="modal-title h2" id="exampleModalLabel">@Localizer["ChangesAppliedSuccessfullyTitle"]</h5>
            </div>
            <div class="modal-body">
                <p class="h3">@Localizer["DearUserMessage"]<br /></p>
                <p class="h4">
                    <br />@Localizer["InformationUpdatedMessage"]<br /><br /><br />
                    @Localizer["EmailLinkMessage"]
                </p>
            </div>
            <div class="modal-footer">
                <a href="/Logout" class="btn btn-outline-primary">@Localizer["LoginButton"]</a>
            </div>
        </div>
    </div>
</div>
