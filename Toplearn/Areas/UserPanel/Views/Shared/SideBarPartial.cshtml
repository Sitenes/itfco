@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer
@using System.Security.Claims
@inject Toplearn.Core.Services.IUserService _userService

@{
	var userAvatar = _userService.GetAvaterByUserName(User.Identity.Name);
}
<div class="col-md-3 col-sm-4 col-xs-12">
	<aside>

		<div class="avatar-layer">
			<div class="img-layer">
				<img src="/UserAvatar/@(userAvatar)" style="max-width:100%" />
			</div>
			<div class="detail">
				@User.Identity.Name
			</div>
		</div>

		<section>
			<header><h3>@Localizer["Dashboard"]</h3></header>
			<div class="inner">
				<ul>
					<li><a href="/UserPanel">@Localizer["ViewAccount"]</a></li>
					<li><a href="/UserPanel/Edit">@Localizer["EditAccount"]</a></li>
					<li><a href="/UserPanel/Wallet">@Localizer["Wallet"]</a></li>
					<li><a href="/UserPanel/ChangePassword">@Localizer["ChangePassword"]</a></li>
					<li><a href="/Logout">@Localizer["Logout"]</a></li>
				</ul>
			</div>
		</section>
	</aside>
</div>
