@using Toplearn.Core.Convertors
@model WalletViewModel
@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer
@{
    ViewData["Title"] = "WalletIndex";
}
<main>
    <div class="container">
        <div class="user-account">
            <div class="row">
                <partial name="SideBarPartial" />
                <div class="col-md-9 col-sm-8 col-xs-12">

                    <section class="user-account-content">
                        <header class="text-center"><h1>@Localizer["WalletTitle"]</h1></header>
                        <div class="inner form-layer">
                            <form asp-action="Index" method="Post">
                                <div class="row">

                                    <div class="col-md-7 col-sm-8 col-xs-12">
                                        <div class="input-group">
                                            <span class="input-group-addon" id="username"><i class="zmdi zmdi-balance-wallet"></i></span>
                                            <input type="number" class="form-control" asp-for="ChargeAmount" placeholder="@Localizer["ChargeAmountLabel"]" value="" aria-describedby="amount">
                                        </div>
                                        <span asp-validation-for="ChargeAmount" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 col-sm-4 col-xs-12">
                                        <button class="btn btn-success btn-block">@Localizer["ChargeWalletButton"]</button>
                                    </div>
                                </div>

                            </form>
                        </div>

                        @if (Model.Wallets.Count != 0)
                        {
                            <table class="table table-striped">
                                <thead class="btn-success text-white">
                                    <tr class="text-center">
                                        <td>@Localizer["TransactionAmount"]</td>
                                        <td>@Localizer["TransactionType"]</td>
                                        <td>@Localizer["TransactionDate"]</td>
                                        <td>@Localizer["TransactionDescription"]</td>
                                    </tr>
                                </thead>
                                @foreach (var WalletItem in Model.Wallets)
                                {
                                    <tr>
                                        <td>
                                            <p class="text-center h4">@(WalletItem.Amount.ToPrice())</p>
                                        </td>
                                        <td>
                                            @if (@WalletItem.TypeId == 1)
                                            {
                                                <p class="h5 text-success text-center">@Localizer["DepositTransaction"]</p>
                                            }
                                            else
                                            {
                                                <p class=" h5 text-danger text-center">@Localizer["WithdrawalTransaction"]</p>
                                            }
                                        </td>
                                        <td>
                                            <p class="h5 text-dark text-center">@WalletItem.PayDate.ToShamsi()</p>
                                        </td>
                                        <td>
                                            <p class="h6 text-center">@WalletItem.Description</p>
                                        </td>
                                    </tr>
                                }
                            </table>
                        }
                        else
                        {
                            <p>@Localizer["NoWalletTransactions"]</p>
                        }
                    </section>
                </div>

            </div>
        </div>
    </div>
</main>
