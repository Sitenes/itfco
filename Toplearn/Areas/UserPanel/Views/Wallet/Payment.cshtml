@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

@{
	ViewData["Title"] = Localizer["TitlePayment"];
}

<main>
	<div class="container">
		<div class="user-account">
			<div class="row">
				<partial name="SideBarPartial" />
				<div class="col-md-9 col-sm-8 col-xs-12">
					<section class="user-account-content">
						<header>
							<div class="text-center h3 font-weight-bolder">@Localizer["PaymentDetails"]</div>
						</header>
						<div class="inner">
							@if (ViewBag.RefId != 0)
							{
								<!-- Modal -->
								<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
									<div class="modal-dialog" role="document">
										<div class="modal-content">
											<div class="modal-header alert-success">
												<button type="button" class="close" data-dismiss="modal" aria-label="Close">
													<span aria-hidden="true">&times;</span>
												</button>
												<p class="modal-title h3" id="exampleModalLabel">@Localizer["PaymentSuccessTitle"]</p>
											</div>
											<div class="modal-body">
												<p class="h4">
													<strong>@(User.Identity.Name)</strong><br /><br /><br />
													@string.Format(Localizer["PaymentSuccessMessage"], User.Identity.Name)
												</p>
											</div>
											<div class="modal-footer">
												<a data-dismiss="modal" class="btn btn-primary" style="min-width:110px">@Localizer["PaymentDetails"]</a>
											</div>
										</div>
									</div>
								</div>
								<script>
									$(document).ready(function () {
										setTimeout(function () {
											$('#exampleModal').modal('show');
											setTimeout(function () { $('#exampleModal').modal('hide'); }, 10000);
										}, 500);
									});
								</script>

								<div class="card border-info mb-3" style="max-width:100%; align-self:center;text-align:center">
									<div class="card-body text-info">
										<p class="card-title h4" style="margin:20px">
											@string.Format(Localizer["PaymentSuccessSummary"], User.Identity.Name, ViewBag.Amount)
										</p>
									</div>
									<div class="h4 list-group">
										<ul>
											<li class="list-group-item">
												@Localizer["Price"] : @(ViewBag.Amount) <small class="font-weight-light"><sup>ریال</sup></small>
											</li>
											<li class="list-group-item">
												@Localizer["TransactionRefId"] : @(ViewBag.RefId)
											</li>
											<li class="list-group-item">
												@Localizer["CartRefId"] : @(ViewBag.CartId)
											</li>
										</ul>
									</div>
								</div>
							}
							else
							{
								<!-- Modal -->
								<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
									<div class="modal-dialog" role="document">
										<div class="modal-content">
											<div class="modal-header alert-danger">
												<button type="button" class="close" data-dismiss="modal" aria-label="Close">
													<span aria-hidden="true">&times;</span>
												</button>
												<h5 class="modal-title h2" id="exampleModalLabel">@Localizer["PaymentFailedTitle"]</h5>
											</div>
											<div class="modal-body">
												<p class="h4">@Localizer["PaymentFailedMessage"]</p>
											</div>
											<div class="modal-footer">
												<a href="/" class="btn btn-default">@Localizer["ReturnToHome"]</a>
												<button type="button" class="btn btn-primary" style="min-width:100px" data-dismiss="modal">@Localizer["Details"]</button>
											</div>
										</div>
									</div>
								</div>
								<script>
									$(document).ready(function () {
										setTimeout(function () {
											$('#exampleModal').modal('show');
											setTimeout(function () { $('#exampleModal').modal('hide'); }, 10000);
										}, 500);
									});
								</script>

								<div class="card border-warning mb-3" style="max-width:100%; align-self:center;text-align:center">
									<div class="card-body text-danger">
										<h5 class="card-title" style="margin:20px">
											@string.Format(Localizer["PaymentFailedSummary"], User.Identity.Name)
										</h5>
									</div>
									<p class="h5" style="margin:20px">
										@Localizer["PaymentFailedSupport"]
									</p>
									<div class="h4 list-group" style="margin:20px">
										<ul>
											<li class="list-group-item" style="margin:5px 5px 0px 5px">
												@Localizer["Price"] : @(ViewBag.Amount) <small class="font-weight-light"><sup>ریال</sup></small>
											</li>
											<li class="list-group-item" style="margin:0px 5px">
												@Localizer["TransactionRefId"] : @(ViewBag.RefId)
											</li>
											<li class="list-group-item" style="margin:0px 5px">
												@Localizer["CartRefId"] : @(ViewBag.CartId)
											</li>
										</ul>
									</div>
								</div>
							}
						</div>
					</section>
				</div>
			</div>
		</div>
	</div>
</main>
