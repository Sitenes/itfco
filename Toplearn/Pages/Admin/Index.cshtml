@page
@model Toplearn.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "پنل ادمین";
}
<h1>به پنل مدیریت وبسایت ایده طرح فرزانگان خوش آمدید</h1>
<hr />
<div class="dashboard-container">
    <div class="dashboard-grid">

        <!-- مدیریت کاربران -->
        <div class="dashboard-item">
            <i class="zmdi zmdi-account-circle zmdi-hc-3x"></i>
            <h3>مدیریت کاربران</h3>
            <a href="/Admin/ManageUser/UserList?currentPage=1" class="btn btn-primary">لیست کاربران</a>
            <a href="/Admin/ManageUsers/AddUser" class="btn btn-success">افزودن کاربر جدید</a>
        </div>

        <!-- مدیریت نقش‌ها -->
        <div class="dashboard-item">
            <i class="zmdi zmdi-lock zmdi-hc-3x"></i>
            <h3>مدیریت نقش‌ها</h3>
            <a href="/Admin/ManageRoles/Index" class="btn btn-primary">لیست نقش‌ها</a>
            <a href="/Admin/ManageRoles/Create" class="btn btn-success">افزودن نقش جدید</a>
        </div>

        <!-- محصولات -->
        <div class="dashboard-item">
            <i class="zmdi zmdi-label zmdi-hc-3x"></i>
            <h3>محصولات</h3>
            <a href="/Admin/Courses/Index" class="btn btn-primary">لیست محصولات</a>
            <a href="/Admin/Courses/Create" class="btn btn-success">افزودن محصول جدید</a>
            <a href="/Admin/Courses/Discount" class="btn btn-warning">کد تخفیف</a>
        </div>

        <!-- دسته‌بندی‌ها -->
        <div class="dashboard-item">
            <i class="zmdi zmdi-view-module zmdi-hc-3x"></i>
            <h3>دسته‌بندی‌ها</h3>
            <a href="/Admin/ManageCategories/Index" class="btn btn-primary">لیست دسته‌بندی‌ها</a>
            <a href="/Admin/ManageCategories/Create" class="btn btn-success">افزودن دسته‌بندی جدید</a>
        </div>

        <!-- سفارشات -->
        <div class="dashboard-item">
            <i class="zmdi zmdi-shopping-cart zmdi-hc-3x"></i>
            <h3>سفارشات</h3>
            <a href="/Admin/Wallets/Index" class="btn btn-primary">لیست سفارشات</a>
        </div>

        <!-- وبلاگ -->
        <div class="dashboard-item">
            <i class="zmdi zmdi-comment-alt-text zmdi-hc-3x"></i>
            <h3>وبلاگ</h3>
            <a href="/Admin/Blogs/BlogList" class="btn btn-primary">لیست مقالات</a>
            <a href="/Admin/Blogs/Edit" class="btn btn-success">افزودن مقاله جدید</a>
        </div>

        <!-- تنظیمات -->
        <div class="dashboard-item">
            <i class="zmdi zmdi-settings zmdi-hc-3x"></i>
            <h3>تنظیمات</h3>
            <a href="/Admin/Settings" class="btn btn-primary">ویرایش تنظیمات</a>
        </div>

    </div>
</div>



