@page
@model Toplearn.Web.Pages.Admin.Wallets.IndexModel

@{
    Guid _userId = Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);
    ViewData["Title"] = "لیست سبد خرید";
}

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                لیست سبد خرید
            </div>
            <!-- /.panel-heading -->
            <div class="panel-body">
                <div class="table-responsive">
                    <form method="post" >
                        <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
                            <div class="row text-center">
                                <input type="hidden" asp-for="@(Model.Filters.CurrentPage)">
                                <input type="hidden" asp-for="@(Model.Filters.ItemPerPage)">
                                <div class="col-xs-6 col-md-3">
                                    <div class="form-group">

                                        <input class="form-control btn-block" value="@Model.Filters.FilterNameId"  asp-for="@Model.Filters.FilterNameId" placeholder=" نام کاربری یا آیدی">
                                    </div>
                                </div>

                                <div class="col-xs-6 col-md-3">
                                    <div class="form-group">

                                        <input class="form-control btn-block" value="@Model.Filters.FilterEmail"  asp-for="@Model.Filters.FilterEmail" placeholder="جستجو ایمیل">
                                    </div>
                                </div>
                                <div class="col-xs-6 col-md-3">
                                    <div class="form-group">

                                        <select asp-for="@Model.Filters.IsPaid" class="form-control">
                                            <option value="null">پرداخت شده و نشده</option>
                                            <option value="true">پرداخت شده</option>
                                            <option value="false">پرداخت نشده</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-6 col-md-3">
                                    <div class="form-group">

                                        <input class="form-control btn-block" value="@((Model.Filters.FilterPhone==0)?"":$"{Model.Filters.FilterPhone}")"  asp-for="@Model.Filters.FilterPhone" placeholder="جستجو موبایل">
                                    </div>
                                </div>

                                <div class="col-xs-6 col-md-3" style="margin:10px 0px;">
                                    <div class="checkbox btn-block">
                                        <label>
                                            <input type="checkbox" name="@(nameof(Model.Filters)+"."+nameof(Model.Filters.OnlyActivate))" value="true" @((Model.Filters.OnlyActivate.GetValueOrDefault(false) ? "checked" : ""))>فقط کاربران فعال
                                        </label>
                                    </div>

                                </div>

                                <div class="col-xs-6 col-md-3">
                                    <div class="form-group">
                                        <input class="form-control btn-block" asp-for="@Model.Filters.PriceFrom" value="@((Model.Filters.PriceFrom==0)?"":$"{Model.Filters.PriceFrom}")" placeholder="قیمت از">
                                    </div>
                                </div>

                                <div class="col-xs-6 col-md-3">
                                    <div class="form-group">
                                        <input class="form-control btn-block" asp-for="@Model.Filters.PriceTo" value="@((Model.Filters.PriceTo==0)?"":$"{Model.Filters.PriceTo}")" placeholder="قیمت تا">
                                    </div>
                                </div>

                                <div class="col-xs-6 col-md-4" style="margin:10px 0px;">
                                    <div class="dataTables_length" id="dataTables-example_length">
                                        <label>
                                            تعداد آیتم در صفحه
                                            <div class="id_100">
                                                <select asp-for="@Model.Filters.ItemPerPage" class="form-control input-sm">
                                                    <option value="10">10</option>
                                                    <option value="25">25</option>
                                                    <option value="50">50</option>
                                                    <option value="100">100</option>
                                                </select>
                                            </div>
                                        </label>
                                    </div>
                                </div>

                                <div class="col-xs-3 btn-group" style="margin:10px 0px;">
                                    <button type="submit" class="btn btn-primary btn-outline btn-group" style="width:80%" asp-route-currentPage=1>
                                        <i class="fa fa-search"></i> <strong> جستجو </strong>
                                    </button>
                                    <a href="" class="btn btn-danger btn-outline btn-group">
                                        <i class="zmdi zmdi-close-circle"></i>
                                    </a>
                                </div>
                            </div>

                            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables-example" aria-describedby="dataTables-example_info">
                                <thead>
                                    <tr role="row" class="h4 text-center">
                                        <th>کاربر</th>
                                        <th>وضعیت</th>
                                        <th>مجموع قیمت</th>
                                        <th>تعداد ایتم ها</th>
                                        <th>کد تخفیف</th>
                                        <th>دستورات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Carts != null)
                                        @foreach (var courseItem in Model.Carts)
                                        {
                                            <tr class="gradeA odd">

                                                <td class=" center ">@courseItem.UserCreator?.UserName</td>
                                                @* <td class=" center ">@courseItem.NumberOfStudents</td> *@
                                                <td class="center ">
                                                    @if (courseItem.IsPaid)
                                                    {
                                                        <span class="badge alert-success"><i class="zmdi zmdi-check"></i> پرداخت شده </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge alert-warning"> <i class="zmdi zmdi-close"></i> پرداخت نشده </span>
                                                    }
                                                </td>
                                                <td class="center">
                                                    @if (courseItem.Discount != null)
                                                    {
                                                        <span style="text-decoration: line-through;">@courseItem.GetPrice()</span>
                                                        <br />
                                                        <span>@courseItem.GetPriceWithDiscount()</span>
                                                    }
                                                    else
                                                    {
                                                        @courseItem.GetPrice()
                                                    }
                                                </td>
                                                <td class="center">@courseItem.CourseCarts?.Count()</td>
                                                <td class="center">@courseItem.Discount?.Title</td>

                                                <td class="center tooltip-demo">

                                                    @if (_permission.CheckPermission(Toplearn.Core.AllEnums.PermissionEnum.RemoveCart, _userId).Result)
                                                    {
                                                        <a class="btn btn-outline btn-danger " data-toggle="modal" data-target="#DeleteModal@(courseItem.Id)">
                                                            <i class="zmdi zmdi-delete"></i>
                                                        </a>
                                                    }

                                                    @if (_permission.CheckPermission(Toplearn.Core.AllEnums.PermissionEnum.EditUser, _userId).Result)
                                                    {
                                                        <a href="/Admin/Wallets/Edit/@(courseItem.Id)" class="btn btn-outline btn-warning "><i class="fa fa-edit"></i></a>
                                                    }
                                                    <div class="modal fade" id="DeleteModal@(courseItem.Id)" tabindex="-1" role="dialog" aria-labelledby="DeleteModalLabel" aria-hidden="true" style="display: none;">
                                                        <div class="modal-dialog">
                                                            <div class="modal-content">
                                                                <div class="modal-header alert-warning">
                                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                        <span aria-hidden="true">&times;</span>
                                                                    </button>
                                                                    <h5 class="modal-title h2" id="exampleModalLabel">آیا از حذف سبد خرید @(courseItem.UserCreator?.UserName) اطمینان دارید ؟</h5>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-default btn-outline" data-dismiss="modal" aria-label="Close">بیخیال</button>
                                                                    <a class="btn btn-danger" style="min-width:100px" href="/api/Cart/Delete/@(courseItem.Id)">حذف</a>
                                                                </div>
                                                            </div>
                                                            <!-- /.modal-content -->
                                                        </div>
                                                        <!-- /.modal-dialog -->
                                                    </div>

                                                </td>
                                            </tr>

                                        }
                                </tbody>
                            </table>

                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="dataTables_info" id="dataTables-example_info" role="alert" aria-live="polite" aria-relevant="all">
                                        نمایش
                                        <b>@((Model.Filters.CurrentPage - 1) * Model.Filters.ItemPerPage + 1)</b>
                                        تا
                                        <b>@((Model.Filters.CurrentPage) * Model.Filters.ItemPerPage + 1)</b>
                                        از
                                        <b>@(Model.Filters.CoursesCount)</b>
                                        محصول
                                    </div>
                                </div>
                                @if (Model.Filters.CoursesCount / Model.Filters.ItemPerPage > 1)
                                {
                                    <div class="col-sm-6">
                                        <div class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                            <div class="btn-group">
                                                <ul class="pagination">
                                                    @if (Model.Filters.CurrentPage > 1)
                                                    {

                                                        <li>
                                                            <button asp-route-currentPage="@(Model.Filters.CurrentPage-1)" class="btn btn-outline btn-primary " type="submit">
                                                                <i class="zmdi zmdi-arrow-right"></i>
                                                            </button>
                                                        </li>
                                                    }
                                                    @for (int i = 1; i <= Model.Filters.CoursesCount / Model.Filters.ItemPerPage + ((Model.Filters.CoursesCount % Model.Filters.ItemPerPage == 0) ? 0 : 1); i++)
                                                    {
                                                        <li>
                                                            <button class="btn btn-primary btn-sm @((i == Model.Filters.CurrentPage)?"":"btn-outline") " type="submit" asp-route-CurrentPage="@(i)">
                                                                @i
                                                            </button>
                                                        </li>

                                                    }
                                                    @if (Model.Filters.CurrentPage < Model.Filters.CoursesCount / Model.Filters.ItemPerPage + ((Model.Filters.CoursesCount % Model.Filters.ItemPerPage == 0) ? 0 : 1))
                                                    {

                                                        <li>
                                                            <button asp-route-CurrentPage="@(Model.Filters.CurrentPage+1)" class="btn btn-outline btn-primary" type="submit">
                                                                <i class="zmdi zmdi-arrow-left"></i>
                                                            </button>
                                                        </li>
                                                    }

                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                }




                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!-- /.table-responsive -->
    </div>
    <!-- /.panel-body -->
</div>
<!-- Modal -->
@section Scripts
{
    <script>
        // tooltip demo
        $('.tooltip-demo').tooltip({
            selector: "[data-toggle=tooltip]",
            container: "body"
        })

        // popover demo
        $("[data-toggle=popover]")
            .popover()
    </script>
}
