@page
@using Toplearn.Core.DTOs.CourseVM
@using Toplearn.DataLayer.Entities.Courses
@model Toplearn.Web.Pages.Admin.ManageCategories.IndexModel
@{
	ViewData["Title"] = "لیست دسته بندی ها";
	Guid _userId = Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);
}
<div class="row">
	<div class="col-lg-12">
		<div class="panel panel-default">
			<div class="panel-heading">
				لیست دسته بندی ها
			</div>
			<!-- /.panel-heading -->
			<div class="panel-body">
				<div class="table-responsive">
					<div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
						<div class="row text-center">
							<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables-example" aria-describedby="dataTables-example_info">
								<thead>
									<tr role="row" class="h4 text-center">
										<th class="center">نام فارسی</th>
										<th class="center">نام انگلیسی</th>
										<th class="center">نام عربی</th>
										<th class="center">دسته پدر</th>
										<th class="center">عملیات</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var category in Model.Category ?? new List<CategoryDto>())
									{

										<tr class="gradeA odd">
											<td class="center">@category.NamePersian</td>
											<td class="center">@category.NameEnglish</td>
											<td class="center">@category.NameArabic</td>
											<td class="center ">@(category.Parent == null?"ندارد":category.Parent.NamePersian)</td>
											<td class="center ">

												<a href="/Admin/ManageCategories/Details/@category.Id" class="btn btn-outline btn-info"><i class="fa fa-info"></i></a>

												@if (_permission.CheckPermission(Toplearn.Core.AllEnums.PermissionEnum.EditCategory, _userId).Result)
												{
													<a href="/Admin/ManageCategories/Edit/@category.Id" class="btn btn-outline btn-warning"><i class="fa fa-edit"></i></a>
												}

												@if (_permission.CheckPermission(Toplearn.Core.AllEnums.PermissionEnum.RemoveCategory, _userId).Result)
													{
													<a class="btn btn-outline btn-danger" data-toggle="modal" data-target="#DeleteModal@(category.Id)">
													<i class="zmdi zmdi-delete"></i>
												</a>
													}

												<div class="modal fade" id="DeleteModal@(category.Id)" tabindex="-1" role="dialog" aria-labelledby="DeleteModalLabel" aria-hidden="true" style="display: none;">
													<div class="modal-dialog">
														<div class="modal-content">
															<div class="modal-header alert-warning">
																<button type="button" class="close" data-dismiss="modal" aria-label="Close">
																	<span aria-hidden="true">&times;</span>
																</button>
																<h5 class="modal-title h2" id="exampleModalLabel">آیا از حذف @(category.NamePersian) اطمینان دارید ؟</h5>
															</div>
															<div class="modal-footer">
																<button type="button" class="btn btn-default btn-outline" data-dismiss="modal" aria-label="Close">بیخیال</button>
																<a class="btn btn-danger" style="min-width:100px" href="/Admin/ManageCategories/Delete?id=@(category.Id)">حذف</a>
															</div>
														</div>
														<!-- /.modal-content -->
													</div>
													<!-- /.modal-dialog -->
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts
{
	@if (ViewData["IsSucceed"] != null && (bool)(ViewData["IsSucceed"]) == true)
	{
		<partial name="_SucceedModalPartial" model="@("/Admin/ManageCategories/Index")" />
	}
}
