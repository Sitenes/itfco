@using Toplearn.Core.Services.Interfaces
@inject IBlogService _blogService
<!-- Main Footer -->
<footer class="main-footer alternate" style="background-image: url(/images/background/5.jpg);">
    <div class="auto-container">
        <!--Widgets Section-->
        <div class="widgets-section">
            <div>
                <!--Big Column-->
                <div class="big-column">
                    <div class="row">
                        <!--Footer Column-->
                        <div class="footer-column col-lg-4 col-md-6 col-sm-12">
                            <div class="footer-widget about-widget">
                                <div class="footer-logo">
                                    <figure>
                                        <a href="/"><img class="logo" src="/images/footer-logo.png" alt="شرکت ایده طرح فرزانگان"></a>
                                        <a class="text">
                                            شرکت ایده طرح فرزانگان
                                        </a>
                                    </figure>
                                </div>
                                <div class="widget-content">
                                    <div>
                                    </div>
                                    <div>
                                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3357.4589170029935!2d51.83201411124869!3d32.70043108778636!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3fbc4f005725d1c5%3A0xb61ba2465c133717!2z2KLYrNix2YbZhdinINqv2YTYs9iq2KfZhtuM!5e0!3m2!1sen!2s!4v1734658830565!5m2!1sen!2s" width="300" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Footer Column-->
                        @{
                            var blogs = await _blogService.SearchAsync(new Toplearn.Core.DTOs.TeacherVM.BlogFilter
            {
                PageNumber = 1,
                PageSize = 2,
            });
                        }
                        @if (blogs.Any())
                        {
                            <div class="footer-column col-lg-4 col-md-6 col-sm-12">
                                <div class="footer-widget recent-posts">
                                    <h2 class="widget-title">اخرین مقالات</h2>

                                    <!--Footer Column-->
                                    <div class="widget-content">
                                        @foreach (var blog in blogs)
                                        {
                                            <div class="post">
                                                <div class="thumb">
                                                    <a href="/Blog/BlogDetail/@blog.Id">
                                                        <img src="/BlogRoot/ThumbImage/@blog.Image" alt="@blog.Title">
                                                    </a>
                                                </div>
                                                <h4><a href="/Blog/BlogDetail/@blog.Id">@blog.Title</a></h4>
                                                <ul class="info">
                                                    <li style="direction:ltr">@blog.CreateDate.ToString("yyyy MMM dd")</li>
                                                </ul>
                                            </div>
                                        }
                                    </div>

                                </div>
                            </div>
                        }
                        <div class="footer-column col-lg-4 col-md-6 col-sm-12">
                            <div class=" clearfix">
                                <div class="footer-column">
                                    <div class="footer-widget links-widget">
                                        <h2 class="widget-title">لینک های دسترسی سریع</h2>
                                        <div class="widget-content">
                                            <ul class="list">
                                                <li class="current"><a href="/">خانه</a></li>
                                                <li><a href="/Product">محصولات</a></li>
                                                <li><a href="/UserPanel">داشبورد کاربری</a></li>
                                                <li><a href="/blog/BlogList">وبلاگ</a></li>
                                                <li><a href="/Home/AboutUs">درباره ما</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>

    <!--Footer Bottom-->
    <div class="footer-bottom">
        <div class="auto-container">
            <div class="inner-container clearfix">
                <div class="social-links">
                    <ul class="social-icon-two">
                        <li>
                            <a href="https://wa.me/+989939910301/?text=" class="contact-info" target="_blank">
                                <i class="fa fa-whatsapp"></i>
                            </a>
                        </li>
                        <li>
                            <a href="https://t.me/Mehdi87mg" class="contact-info" target="_blank">
                                <i class="fa fa-telegram"></i>
                            </a>
                        </li>
                        <li>
                            <a href="https://www.facebook.com/share/17r9qoRfvv/" class="contact-info" target="_blank">
                                <i class="fa fa-facebook-f"></i>
                            </a>
                        </li>
                        <li>
                            <a href="https://instagram.com/itfco7" class="contact-info" target="_blank">
                                <i class="fa fa-instagram"></i>
                            </a>
                        </li>
                        <li>

                            <a href="tel:+989133073417" class="contact-info"
                               style="font-family:sans-serif,'Franklin Gothic Medium', 'Arial Narrow', Arial">
                                989133073417+ <i class="fa fa-volume-control-phone contact-info"></i>
                            </a>
                        </li>
                        <li>

                            <a href="mailto:golastani@gmail.com" class="contact-info"> golastani@gmail.com <i class="fa fa-envelope contact-info"></i></a>
                        </li>
                    </ul>
                </div>

                <div class="copyright-text">
                    <p>طراحی شده توسط پارسه آذین مبین</p>
                </div>
            </div>
        </div>
    </div>
</footer>
<!-- End Main Footer -->