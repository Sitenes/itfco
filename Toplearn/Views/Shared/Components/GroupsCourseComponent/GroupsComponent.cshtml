@using System.Globalization
@using Toplearn.DataLayer.Entities.Courses
@{
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
<!-- main menu -->
@model IEnumerable<CourseGroup>

<div class="main-menu">
    <div class="container">
        <nav>
            <span class="responsive-sign"><i class="zmdi zmdi-menu"></i></span>
            <ul>
                @foreach (var groupItem in Model.Where(n => n.ParentId == null).ToList())
                {
                    var groupTitle = groupItem.NamePersian;
                    if (currentCulture == "en")
                    {
                        groupTitle = groupItem.NameEnglish;
                    }
                    else if (currentCulture == "ar")
                    {
                        groupTitle = groupItem.NameArabic;
                    }

                    <li>
                        <a href="">@groupTitle</a>
                        <ul>
                            @foreach (var subGroupItem in Model.Where(n => n.ParentId == groupItem.GroupId).ToList())
                            {
                                var subGroupTitle = subGroupItem.NamePersian;
                                if (currentCulture == "en")
                                {
                                    subGroupTitle = subGroupItem.NameEnglish;
                                }
                                else if (currentCulture == "ar")
                                {
                                    subGroupTitle = subGroupItem.NameArabic;
                                }

                                <li><a href="">@subGroupTitle</a></li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
<!-- /main menu -->
