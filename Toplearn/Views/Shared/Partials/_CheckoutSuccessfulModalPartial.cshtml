@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

 <script>
	$(document).ready(function () {
		setTimeout(function () { $('#exampleModal').modal('show'); setTimeout(function () { $('#exampleModal').modal('hide'); }, 5000); }, 500);
	});
</script> 
<!-- Modal -->

<div class="modal fade" id="exampleModal" data-backdrop="false" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header alert-success">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" href="/">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h5 class="modal-title h2" id="exampleModalLabel">ثبت سفارش</h5>
            </div>
            <div class="modal-body">
                <p class="h4">
                    <strong>@(User.Identity.Name)</strong>عزیز
                    <br />
                    سفارش شما با موفقیت ثبت شد
                </p>
            </div>
            <div class="modal-footer">
                <a class="btn btn-outline-success" data-dismiss="modal">@Localizer["Understood"]</a>
            </div>
        </div>
    </div>
</div>

