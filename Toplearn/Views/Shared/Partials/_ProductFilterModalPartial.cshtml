@using Toplearn.Core.DTOs.CourseVM
@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer
<!-- main manu -->
@model IEnumerable<CategoryListDto>

<!--Sidebar Side-->
<div class="sidebar-side col-xl-3 col-lg-4 col-md-12">
    <aside class="sidebar">

        <!-- Search -->
        <div class="sidebar-widget search-box">
            <form asp-controller="product" asp-action="index">
                <div class="form-group">
                    <input type="search" name="Title" placeholder="@(Localizer["SearchPlaceholder"])" required>
                    <button type="submit"><span class="icon fa fa-search"></span></button>
                </div>
            </form>
        </div>

        <!--Blog Category Widget-->
        <div class="sidebar-widget sidebar-blog-category">
            <div class="sidebar-title">
                <h3>Categories</h3>
                <div class="separater"></div>
            </div>
            <ul class="cat-list">
                @foreach (var category in Model)
                {
                    <li class="clearfix">
                        <a href="/product?GroupId=@category.Id">
                            @category.Name <span>@category.Count</span>

                        </a>
                    </li>
                    @foreach (var subcategory in category?.SubCategories ?? new List<CategoryListDto>())
                    {
                        <li class="clearfix">
                            <a href="/product?GroupId=@subcategory.Id" style="margin-right:20px">@subcategory.Name <span>@subcategory.Count</span></a>
                        </li>
                        @foreach (var subsubcategory in subcategory?.SubCategories ?? new List<CategoryListDto>())
                        {
                            <li class="clearfix">
                                <a href="/product?GroupId=@subsubcategory.Id" style="margin-right:20px">@subsubcategory.Name <span>@subsubcategory.Count</span></a>
                            </li>
                            @foreach (var subsubsubcategory in subsubcategory?.SubCategories ?? new List<CategoryListDto>())
                            {
                                <li class="clearfix">
                                    <a href="/product?GroupId=@subsubsubcategory.Id" style="margin-right:20px">@subsubsubcategory.Name <span>@subsubsubcategory.Count</span></a>
                                </li>
                            }
                        }
                    }
                }

                @* <li class="clearfix active"><a href="#">Industry <span>49</span></a></li> *@
            </ul>
        </div>

        <!-- Price Filters -->
