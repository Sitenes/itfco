@model Toplearn.Core.DTOs.CourseVM.CourseItemListViewModel
@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

<div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 term-col">
    <article>
        <a href="" class="img-layer">
            @if (string.IsNullOrEmpty(Model.Image))
            {
                <img src="/CourseRoot/Image/Default.png" alt="@Localizer["DefaultImageAlt"]">
            }
            else
            {
                <img style="height:150px" src="/CourseRoot/Image/@(Model.Image)" alt="@Localizer["ProductImageAlt"]">
            }
        </a>
        <h2>
            <a href="">
                @(Model.Title)
            </a>
        </h2>
        @if (Model.Price == 0)
        {
            <span>@Localizer["Free"]</span>
        }
        else
        {
            <span>@(Model.Price.ToString("#,0")) @Localizer["Currency"]</span>
        }
        <i>@(Model.Time)</i>
    </article>
</div>
