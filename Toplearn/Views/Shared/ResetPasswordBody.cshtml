@model Toplearn.Core.DTOs.UserVM.EmailtxtViewModel
@using TopLearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer
@{
    Layout = null;
}
<!DOCTYPE html>
<html class="no-js" dir="rtl" lang="fa-IR">
<head>
    <partial name="Layouts/_MetaTags" />
    <partial name="Layouts/_Styles" />

    <script src="/js/jquery.min.js"></script>
</head>
<body>

    <div style="margin:10%;padding:3%;background-color:#2aaf27">
        <div style="padding:5%;background-color:white">
            <a href="https://itfgod.com/">
                <h1>@Localizer["SiteName"]</h1>
            </a>
            <h1>@(Model.UserName) @Localizer["UserGreeting"]</h1>
            <h2>
                @Localizer["PasswordResetInstruction"]
                <br /><br /><br />
                <a href="https://itfgod.com//ConfirmPassword/@(Model.UserId)/@(Model.EmailLink)">
                    @Localizer["ClickToChangePassword"]
                </a><br />
                <br /><br />
                @Localizer["IgnoreIfNotRequested"]
            </h2>
        </div>
    </div>

</body>
</html>
