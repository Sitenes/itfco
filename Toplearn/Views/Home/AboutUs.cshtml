<!-- Process Section -->
<section class="process-section" style="background-image: url(images/background/8.jpg);">
    <div class="auto-container">
        <div class="sec-title light">
            <span class="float-text">خدمات</span>
            <h2>چرا شرکت ایده طرح فرزانگان رو انتخاب کنید ؟</h2>
        </div>
        <div class="row">
            <!-- Process Block -->
            <div class="process-block col-lg-3 col-md-6 col-sm-12">
                <div class="inner-box">
                    <span class="count">01</span>
                    <h4><a href="/product">تولید حرفه ای</a></h4>
                    <div class="text font-weight-bold">محصولاتی در کلاس جهانی، با پشتوانه دانش فنی و تیم متخصص.</div>
                    <div class="text">
                        ما با بهره‌گیری از کادری مجرب و علمی، محصولاتی دقیق و استاندارد جهانی تولید می‌کنیم تا نیازهای شما به بهترین شکل برآورده شود.
                    </div>
                    <div class="link-box"><a href="/Home/ContactUs">تماس با ما</a></div>
                </div>
            </div>

            <!-- Process Block -->
            <div class="process-block col-lg-3 col-md-6 col-sm-12">
                <div class="inner-box">
                    <span class="count">02</span>
                    <h4><a href="/product">کیفیت بی‌نظیر</a></h4>
                    <div class="text font-weight-bold">دوام و اطمینان با استفاده از بهترین متریال.</div>
                    <div class="text">
                        کیفیت برای ما یک اصل است. استفاده از مواد اولیه درجه یک، محصولات ما را بادوام و قابل اعتماد ساخته است.
                    </div> <div class="link-box"><a href="/product">مشاهده محصولات</a></div>
                </div>
            </div>

            <!-- Process Block -->
            <div class="process-block col-lg-3 col-md-6 col-sm-12">
                <div class="inner-box">
                    <span class="count">03</span>
                    <h4><a href="/product">تنوع در تولید</a></h4>
                    <div class="text font-weight-bold">پاسخگویی به نیازهای شما، بدون محدودیت.</div>
                    <div class="text">
                        ما به رضایت مشتریان متعهدیم. انواع محصولات متناسب با نیاز شما طراحی و تولید می‌شود تا انتخابی آسان و مطمئن داشته باشید.
                    </div>
                </div>
            </div>

            <!-- Process Block -->
            <div class="process-block col-lg-3 col-md-6 col-sm-12">
                <div class="inner-box">
                    <span class="count">04</span>
                    <h4><a href="/product">فنی مهندسی</a></h4>
                    <div class="text font-weight-bold">تجربه‌ای بی‌دغدغه با تعهد به زمان‌بندی.</div>
                    <div class="text">
                        تجربه بالا و دقت، تحویل سریع و به‌موقع محصولات را تضمین می‌کند. ما زمان شما را ارزشمند می‌دانیم.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
