@{
    ViewData["Title"] = "درباره ما";
}

<section class="about-section" style="background-image: url(/images/aboutus/1.jpg);">
    <div class="auto-container">
        <div class="row no-gutters">
            <!-- Image Column -->
            <div class="image-column col-lg-6 col-md-12 col-sm-12 order-">
                <div class="inner-column">
                    <div class="title-box wow fadeInLeft" data-wow-delay='1200ms'>
                        <h2>درباره <br> ما</h2>
                    </div>
                    <div class="image-box wow fadeInRight" data-wow-delay='600ms'>
                        @* <figure class="alphabet-img"><img src="/images/Logo Name.jpg" alt="ایده طرح فرزانگان"></figure> *@
                        <figure class="image"><img src="/images/aboutus/Logo Name.jpg" alt="ایده طرح فرزانگان"></figure>
                    </div>
                </div>
                <div class="inner-column" style="margin-top: 50px;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3357.4589170029935!2d51.83201411124869!3d32.70043108778636!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3fbc4f005725d1c5%3A0xb61ba2465c133717!2z2KLYrNix2YbZhdinINqv2YTYs9iq2KfZhtuM!5e0!3m2!1sen!2s!4v1734658830565!5m2!1sen!2s" width="450" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>

            <!-- Content Column -->
            <div class="content-column col-lg-6 col-md-12 col-sm-12">
                <div class="inner-column wow fadeInLeft">
                    <div class="content-box">
                        <div class="title">
                            <h2>شرکت <strong>ایده طرح فرزانگان</strong></h2>
                        </div>
                        <div class="text">
                            شرکت ایده طرح فرزانگان در سال 1389 تاسیس گردید و در زمینه : طراحی و ساخت ماشین آلات وسازه های صنعتی – طراحی و ساخت ماشین آلات وکارخانجات آجرسفال و آجر نما - ساخت ساز ساختمان ها – راه وترابری – انواع تاسیسات و تجهیزات عمرانی ، شهر سازی – ساخت و عرضه قطعات ماشین آلات و سازه های صنعتی - مشارکت در طرح های عمرانی ، تجاری ، اقتصادی ، صنعتی ، تولیدی ، خرید و فروش – واردات و صادرات تمامی کالاهای مجاز بازرگانی – اخذ و اعطای نمایندگی شرکت های معتبر داخلی و خارجی – اخذ وام و اعتبارات بانکی – شرکت در مناقصات و پیمان ها و مزایده های دولتی و خصوصی فعالیت خودرا آغاز نموده است
                            همچنین این شرکت با استعانت از خداوند متعال ، دانش فنی ، کادر تحصیل کرده و مجرب توانسته گام های بزرگی در زمینه به روزرسانی صنعت کشور بردارد .
                        </div>
                        <div class="link-box"><a href="/Product" class="theme-btn btn-style-one">مشاهده محصولات</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--End About Section -->
<!-- Testimonial Section Two-->
<section class="testimonial-section-two">
