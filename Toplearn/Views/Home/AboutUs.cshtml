@using Toplearn.Core.Services
@inject IUserService _UserServie
@model Toplearn.Core.DTOs.UserVM.EmailtxtViewModel
@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

@{
    ViewData["Title"] = Localizer["AboutUs"];
    Toplearn.DataLayer.Entities.User.User? _user = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        var userIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (Guid.TryParse(userIdClaim.Value, out var _userId))
        {
            _user = await _UserServie.GetUserAsync(_userId);
        }
    }
}

<section class="about-section" style="background-image: url(/images/aboutus/1.jpg);">
    <div class="auto-container">
        <div class="row no-gutters">
            <!-- Image Column -->
            <div class="image-column col-lg-6 col-md-12 col-sm-12 order-">
                <div class="inner-column">
                    <div class="title-box wow fadeInLeft" data-wow-delay='1200ms'>
                        <h2>@Localizer["AboutUs"]</h2>
                    </div>
                    <div class="image-box wow fadeInRight" data-wow-delay='600ms'>
                        <figure class="image"><img src="/images/aboutus/Logo Name.jpg" alt="@Localizer["CompanyName"]"></figure>
                    </div>
                </div>
                <div class="inner-column" style="margin-top: 50px;">
                      @if (_user != null && _user.ShowMap)
                    {
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3357.4589170029935!2d51.83201411124869!3d32.70043108778636!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3fbc4f005725d1c5%3A0xb61ba2465c133717!2z2KLYrNix2YbZhdinINqv2YTYs9iq2KfZhtuM!5e0!3m2!1sen!2s!4v1734658830565!5m2!1sen!2s" width="450" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>

                    }
                    else
                    {
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d188620.34312208623!2d51.835177380857715!3d32.66278909005366!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3fbc35fe8c326799%3A0x7ab57816ef5837f5!2z2KfYtdmB2YfYp9mG2Iwg2KfYs9iq2KfZhiDYp9i12YHZh9in2YbYjCDYp9uM2LHYp9mG!5e0!3m2!1sfa!2s!4v1738617191535!5m2!1sfa!2s" width="450" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>

                    }
                </div>
            </div>

            <!-- Content Column -->
            <div class="content-column col-lg-6 col-md-12 col-sm-12">
                <div class="inner-column wow fadeInLeft">
                    <div class="content-box">
                        <div class="title">
                            <h2>@Localizer["CompanyName"]</h2>
                        </div>
                        <div class="text">
                            @Localizer["CompanyEstablished"]
                        </div>
                        <div class="link-box"><a href="/Product" class="theme-btn btn-style-one">@Localizer["ViewProducts"]</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Testimonial Section Two-->
<section class="testimonial-section-two">
    <div class="auto-container">
        <div class="sec-title">
            <span class="float-text">@Localizer["Testimonials"]</span>
            <h2>@Localizer["CustomerTestimonials"]</h2>
        </div>

        <div class="testimonial-carousel-two owl-carousel owl-theme">
            <!-- Testimonial block two -->
            <div class="testimonial-block-two">
                <div class="inner-box">
                    <div class="info-box">
                        <div class="thumb"><img src="/images/resource/thumb-2.jpg" alt=""></div>
                        <h5 class="name">مهندس <strong>امین آقاکبیری</strong></h5>
                    </div>
                    <div class="text">@Localizer["Testimonial1"]</div>
                </div>
            </div>

            <!-- Testimonial block two -->
            <div class="testimonial-block-two">
                <div class="inner-box">
                    <div class="info-box">
                        <div class="thumb"><img src="/images/resource/thumb-3.jpg" alt=""></div>
                        <h5 class="name">مهندس <strong>مهدی شمس</strong></h5>
                    </div>
                    <div class="text">@Localizer["Testimonial2"]</div>
                </div>
            </div>

            <!-- Testimonial block two -->
            <div class="testimonial-block-two">
                <div class="inner-box">
                    <div class="info-box">
                        <div class="thumb"><img src="/images/resource/thumb-4.jpg" alt=""></div>
                        <h5 class="name">مهندس <strong>ضیایی</strong></h5>
                    </div>
                    <div class="text">@Localizer["Testimonial3"]</div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--End Testimonial Section Two-->

<!-- Process Section -->
<section class="process-section" style="background-image: url(images/background/8.jpg);">
    <div class="auto-container">
        <div class="sec-title light">
            <span class="float-text">@Localizer["Services"]</span>
            <h2>@Localizer["WhyChooseUs"]</h2>
        </div>
        <div class="row">
            <!-- Process Block -->
            <div class="process-block col-lg-3 col-md-6 col-sm-12">
                <div class="inner-box">
                    <span class="count">01</span>
                    <h4><a href="/product">@Localizer["ProfessionalProduction"]</a></h4>
                    <div class="text font-weight-bold">@Localizer["ProfessionalProductionDescBold"]</div>
                    <div class="text">@Localizer["ProfessionalProductionDesc"]</div>
                </div>
            </div>

            <!-- Process Block -->
            <div class="process-block col-lg-3 col-md-6 col-sm-12">
                <div class="inner-box">
                    <span class="count">02</span>
                    <h4><a href="/product">@Localizer["UnmatchedQuality"]</a></h4>
                    <div class="text font-weight-bold">@Localizer["UnmatchedQualityDescBold"]</div>
                    <div class="text">@Localizer["UnmatchedQualityDesc"]</div>
                    <div class="link-box"><a href="/product">@Localizer["ViewProducts"]</a></div>
                </div>
            </div>

            <!-- Process Block -->
            <div class="process-block col-lg-3 col-md-6 col-sm-12">
                <div class="inner-box">
                    <span class="count">03</span>
                    <h4><a href="/product">@Localizer["DiverseProduction"]</a></h4>
                    <div class="text font-weight-bold">@Localizer["DiverseProductionDescBold"]</div>
                    <div class="text">@Localizer["DiverseProductionDesc"]</div>
                </div>
            </div>

            <!-- Process Block -->
            <div class="process-block col-lg-3 col-md-6 col-sm-12">
                <div class="inner-box">
                    <span class="count">04</span>
                    <h4><a href="/product">@Localizer["Engineering"]</a></h4>
                    <div class="text font-weight-bold">@Localizer["EngineeringDescBold"]</div>
                    <div class="text">@Localizer["EngineeringDesc"]</div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End Process Section -->