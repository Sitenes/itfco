@{
    ViewData["Title"] = "خانه";
}
@if (ViewData["Login"] != null && (bool)ViewData["Login"] == true)
{
    <partial name="Partials/_loginSuccessfulModalPartial" />
}

@if (ViewData["Logout"] != null && (bool)ViewData["Logout"] == true)
{
    <partial name="Partials/_LogoutModalPartial" />
}
<!-- Bnner Section -->
<section class="banner-section-two">
    <div class="banner-carousel owl-carousel owl-theme">
        @{
            var imageUrls = new List<string>
        {
        "/images/main-slider/truck 1.webp",
        "/images/main-slider/3.jpg",
        "/images/main-slider/image-3.jpg",
        "/images/main-slider/clothing 2.jpg"
        };

            var slideTitles = new List<string>
        {
        "پیشرو در صنعت <br>خودرو و لوازم یدکی",
        "پیشرو در صنعت <br>لوازم ساختمانی",
        "پیشرو در <br>طراحی و ساخت ماشین آلات صنعتی",
        "پیشرو در صنعت <br>پوشاک و مدلینگ"
        };
        }

        @for (int i = 0; i < imageUrls.Count; i++)
        {
            <div class="slide-item" style="background-image: url('@imageUrls[i]');">
                <div class="auto-container">
                    <div class="content-box">
                        <span class="title">ایده طرح فرزانگان</span>

                        <h2>@Html.Raw(slideTitles[i])</h2>
                        <div class="visit-product">
                            <a asp-controller="product" asp-action="index" class="theme-btn btn-style-one">
                                <i class="icon fa fa-shopping-basket" aria-hidden="true">
                                    <h6 style="display:inline-block">مشاهده محصولات</h6>
                                </i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</section>
<!-- End Bnner Section -->
<!-- Specialize Section -->
@{
    var services = new List<dynamic>
    {
        new { ImageUrl = "/images/main-slider/truck 1.webp", Title = "خودرو و لوازم یدکی", ServiceLink = "/product", DetailLink = "/product" },
        new { ImageUrl = "/images/main-slider/brick 1.webp", Title = "لوازم ساختمانی", ServiceLink = "/product", DetailLink = "/product" },
        new { ImageUrl = "/images/resource/service-6.jpg", Title = "ماشین آلات صنعتی", ServiceLink = "/product", DetailLink = "/product" },
        new { ImageUrl = "/images/main-slider/clothing 2.jpg", Title = "پوشاک و مدلینگ", ServiceLink = "/product", DetailLink = "/product" }
    };
}

<section class="specialize-section bottom-zero">
    <div class="auto-container">
        <div class="sec-title">
            <h2>دسته بندی ها</h2>
        </div>

        <div class="services-carousel-two owl-carousel owl-carousel1 owl-theme">
            @for (int i = 0; i < services.Count; i++)
            {
                <div class="service-block-two">
                    <div class="inner-box">
                        <div class="image-box">
                            <figure class="image">
                                <a href="@services[i].ServiceLink">
                                    <img src="@services[i].ImageUrl" alt="">
                                </a>
                            </figure>
                        </div>
                        <div class="caption-box">
                            <h3><a href="@services[i].ServiceLink">@services[i].Title</a></h3>
                            <div class="link-box">
                                <a href="@services[i].DetailLink">
                                    مشاهده محصولات<i class="fa fa-angle-double-left"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>


<!-- End Specialize Section -->
<!-- Fun Fact And Features -->
<section class="fun-fact-and-features" style="background-image: url(/images/background/3.jpg);">
    <div class="outer-box">
        <div class="auto-container">
            <!-- Fact Counter -->
            <div class="fact-counter">
                <div class="row">
                    <!--Column-->
                    <div class="counter-column col-lg-3 col-md-6 col-sm-12 wow fadeInUp">
                        <div class="count-box">
                            <div class="count">
                                <span class="count-text" data-speed="5000"
                                      data-stop="14">40</span>
                            </div>
                            <h4 class="counter-title">سال ها<br>تجربه</h4>
                        </div>
                    </div>

                    <!--Column-->
                    <div class="counter-column col-lg-3 col-md-6 col-sm-12 wow fadeInUp" data-wow-delay="400ms">
                        <div class="count-box">
                            <div class="count">
                                <span class="count-text" data-speed="5000"
                                      data-stop="237">10</span>
                            </div>
                            <h4 class="counter-title">تعداد <br>محصول</h4>
                        </div>
                    </div>

                    <!--Column-->
                    <div class="counter-column col-lg-3 col-md-6 col-sm-12 wow fadeInUp" data-wow-delay="800ms">
                        <div class="count-box">
                            <div class="count">
                                <span class="count-text" data-speed="5000"
                                      data-stop="11">5</span>K
                            </div>
                            <h4 class="counter-title">تعداد <br> مشتریان</h4>
                        </div>
                    </div>

                    <!--Column-->
                    <div class="counter-column col-lg-3 col-md-6 col-sm-12 wow fadeInUp"
                         data-wow-delay="1200ms">
                        <div class="count-box">
                            <div class="count">
                                <span class="count-text" data-speed="5000"
                                      data-stop="12">1000</span>
                            </div>
                            <h4 class="counter-title">تعداد<br>نیرو</h4>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</section>
<!--End Fun Fact Section -->
