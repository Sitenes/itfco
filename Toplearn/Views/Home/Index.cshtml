<!-- Offer Section -->
<section class="offer-section" style="background-image: url(/images/background/6.jpg);">
    <div class="auto-container">
        <div class="row">
            <div class="content-column col-lg-6 col-md-12 col-sm-12">
                <div class="inner-column">
                    <span class="title">از تخفیفات ما اگاه شوید</span>
                    <h2><span>افزایش بهروری</span> <br>و کاهش هزینه ها</h2>
                    <span class="discount">30%</span>
                    <div class="text">تا 30 درصد از <br> ایده طرح فرزانگان تخفیف بگیرید</div>
                </div>
            </div>

            <div class="form-column order-last col-lg-6 col-md-12 col-sm-12">
                <div class="inner-column">
                    <div class="discount-form">
                        <!--Comment Form-->
                        <form method="post" >
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                                    <input type="text" name="username" placeholder="نام" required>
                                </div>

                                <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                                    <input type="email" name="email" placeholder="ایمیل" required>
                                </div>

                                <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                                    <input type="text" name="phone" placeholder="تلفن" required>
                                </div>

                                <div class="col-lg-12 col-md-12 col-sm-12 form-group">
                                    <textarea name="message" placeholder="پیام"></textarea>
                                </div>

                                <div class="col-lg-12 col-md-12 col-sm-12 form-group text-center">
                                    <button class="theme-btn btn-style-one" type="submit"
                                            name="submit-form">
                                        ارسال کن
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--End Offer Section -->
