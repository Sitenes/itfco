@model Toplearn.Core.DTOs.UserVM.EmailViewModel
@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

@{
    ViewData["Title"] = "تایید ایمیل";
}
    <partial name="Partials/_SuccessfulActivateModalPartial" model="Model" />


<nav aria-label="breadcrumb" style="margin-bottom:0px">
    <ul class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">@Localizer["Home"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["EmailVerification"]</li>
    </ul>
</nav>

<main class="client-page">
    <div class="container-content" style="width:60%">
        <div class="row">
            <div class="col-md-4">
                <img src="/images/resource/Verified.jpg" alt="Verify">
            </div>
            <div class="col-md-8">
                <div class="">
                    <h2 class="alert alert-success h3">@Localizer["EmailVerifiedSuccess"]</h2>
                    <hr />
                    <p class="h4">@Localizer["LoginToContinue"]</p>
                    <a href="/Login" class="btn btn-success h3">@Localizer["Login"]</a>
                </div>
            </div>
        </div>
    </div>
</main>
