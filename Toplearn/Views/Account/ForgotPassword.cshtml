@model Toplearn.Core.DTOs.UserVM.EmailOnlyViewModel
@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

@{
    ViewData["Title"] = "فراموشی رمز عبور";
}

@if (ViewData["ResetPasswordEmailSend"] != null && (bool)ViewData["ResetPasswordEmailSend"]==true){
    <partial name="Partials/_ResetPasswordEmailSend" model="Model"/>
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ul class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/">@Localizer["Home"]</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Login">@Localizer["Login"]</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Localizer["ForgotPassword"]</li>
        </ul>
    </nav>
</div>

<main class="client-page">
    <div class="container-content">
        <header>
            <h2>@Localizer["SendResetEmail"]</h2>
        </header>

        <div class="form-layer">
            <form action="ForgotPassword" method="post">
                <div class="input-group">
                    <span class="input-group-addon" id="email-address">
                        <i class="zmdi zmdi-email"></i>
                    </span>
                    <input type="email" asp-for="Email" class="form-control" placeholder="@Localizer["Email"]" aria-describedby="email-address">
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>

                <div class="link">
                    <a href="/Login">
                        <i class="zmdi zmdi-lock"></i> @Localizer["Login"]
                    </a>
                    <a href="/Register">
                        <i class="zmdi zmdi-account"></i> @Localizer["Register"]
                    </a>
                </div>
                <button class="theme-btn btn-style-one">@Localizer["SendEmail"]</button>
            </form>
        </div>
    </div>
</main>
