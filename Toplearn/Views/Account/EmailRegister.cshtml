    <ul class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">@Localizer["Home"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["EmailConfirmation"]</li>
    </ul>
</nav> *@

<main class="client-page" style="margin-top:0px">
    <div class="container-content" style="width:70%">
        <div class="row">
            <div class="col-md-4">
                <img src="/images/resource/EmailLink.jpg" />
            </div>
            <div class="col-md-8">
                <p class="h2 text-success">@Localizer["RegistrationSuccessful"]</p>
                <p class="h3" style="margin:8px">
                    @Localizer["Hello"] <strong>@(Model.UserName)</strong><br />
                </p>
                <p class="h4">
                    @Localizer["EmailSentTo"]
                    <a href="https://accounts.google.com/b/0/AddMailService" target="_blank">@(Model.Email)</a>
                    <br />
                </p>
                <p class="h4">
                    @Localizer["CheckEmailForActivation"]
                </p>
            </div>
        </div>
    </div>
</main>