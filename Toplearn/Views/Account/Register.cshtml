@model Toplearn.Core.DTOs.UserVM.RegisterViewModel
@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

@{
    ViewData["Title"] = "ثبت نام";
}
@* <div class="container">
