<main class="client-page" style="margin-top: 35px;">
    <div class="container-content" style="margin-top:0px">

        <header><h2>@Localizer["Register"]</h2></header>

        <div class="form-layer">

            <form asp-action="Register" method="post">
              
                <div class="input-group">
                    <span class="input-group-addon" id="username"><i class="zmdi zmdi-account"></i></span>
                    <input asp-for="UserName" type="text" class="form-control" placeholder="@Localizer["UserNamePlaceholder"]" aria-describedby="username">
                </div>
                <span asp-validation-for="UserName" class="text-danger"></span>

                <div class="input-group">
                    <span class="input-group-addon" id="email-address"><i class="zmdi zmdi-email"></i></span>
                    <input asp-for="Email" type="email" class="form-control" placeholder="@Localizer["Email"]" aria-describedby="email-address">
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>

                <div class="input-group">
                    <span class="input-group-addon" id="phone"><i class="zmdi zmdi-phone"></i></span>
                    <input asp-for="Phone" type="number" class="form-control" placeholder="@Localizer["PhonePlaceholder"]" aria-describedby="phone">
                </div>
                <span asp-validation-for="Phone" class="text-danger"></span>

                <div class="input-group">
                    <span class="input-group-addon" id="password"><i class="zmdi zmdi-lock"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="@Localizer["PasswordPlaceholder"]" aria-describedby="password">
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>

                <div class="input-group">
                    <span class="input-group-addon" id="repassword"><i class="zmdi zmdi-lock"></i></span>
                    <input asp-for="RePassword" type="password" class="form-control" placeholder="@Localizer["RePasswordPlaceholder"]" aria-describedby="repassword">
                </div>
                <span asp-validation-for="RePassword" class="text-danger"></span>

                <div class="link">
                    <a href="/Login"> <i class="zmdi zmdi-account"></i> @Localizer["Login"] </a>
                </div>

                <button class="theme-btn btn-style-one">@Localizer["Register"]</button>

            </form>
        </div>

    </div>
</main>
