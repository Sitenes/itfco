@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer
@using Toplearn.DataLayer.Entities.Courses
@model Course
@using System.Globalization

@{
    ViewData["Title"] = $"محصول {Model.TitlePersian}";
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}

<div class="container">
    <div class="sidebar-page-container">
        <div class="auto-container">
            <div class="row clearfix" style="flex-direction: row-reverse;">

                <!--Content Side-->
                <div class="content-side col-xl-9 col-lg-8 col-md-12">
                    <div class="shop-single">
                        <div class="product-details">

                            <!--Basic Details-->
                            <div class="basic-details">
                                <div class="row clearfix">
                                    <div class="image-column col-md-6 col-sm-12">
                                        <figure class="image-box">
                                            <a href="/CourseRoot/Image/@(Model.Image)" class="lightbox-image" title="Image Caption Here">
                                                <img src="/CourseRoot/Image/@(Model.Image)" alt="@(Model.TitlePersian)">
                                            </a>
                                        </figure>
                                    </div>
                                    <div class="info-column col-md-6 col-sm-12">
                                        <div class="details-header">
                                            <h4>@(currentCulture == "fa" ? Model.TitlePersian : currentCulture == "en" ? Model.TitleEnglish : Model.TitleArabic)</h4>
                                            <div class="rating">
                                                <span class="fa fa-star"></span>
                                                <span class="fa fa-star"></span>
                                                <span class="fa fa-star"></span>
                                                <span class="fa fa-star"></span>
                                                <span class="fa fa-star"></span>
                                            </div>
                                            <div class="item-price">
                                                @(currentCulture == "fa" ? Model.Price.ToString("0,000") : Model.PriceDollar.ToString("0,000")) @Localizer["Tooman"]
                                            </div>
                                        </div>

                                        <div class="text">@(currentCulture == "fa" ? Model.ShortDescriptionPersian : currentCulture == "en" ? Model.ShortDescriptionEnglish : Model.ShortDescriptionArabic)</div>

                                        <div class="other-options clearfix">
                                            <form asp-controller="UserPanel" asp-action="Cart" asp-route-productId="@(Model.CourseId)">
                                                <div class="item-quantity">
                                                    <input class="quantity-spinner form-control" type="text" value="1" name="Count">
                                                </div>
                                                <button type="submit" class="theme-btn btn-style-one add-to-cart">
                                                    @Localizer["AddToCart"]
                                                </button>
                                                @Localizer["Count"]
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--End Basic Details-->
                            <!--Product Info Tabs-->
                            <div class="product-info-tabs">
                                <div class="prod-tabs tabs-box">

                                    <!--Tab Btns-->
                                    <ul class="tab-btns tab-buttons clearfix">
                                        <li data-tab="#prod-details" class="tab-btn active-btn">@Localizer["Description"]</li>
                                        @if (!string.IsNullOrWhiteSpace(Model.DemoFileName))
                                        {
                                            <li data-tab="#prod-video" class="tab-btn">@Localizer["Video"]</li>
                                        }
                                    </ul>

                                    <!--Tabs Container-->
                                    <div class="tabs-content">

                                        <!--Tab Description-->
                                        <div class="tab active-tab" id="prod-details">
                                            <div class="content">
                                                @Html.Raw(currentCulture == "fa" ? Model.DescriptionPersian : currentCulture == "en" ? Model.DescriptionEnglish : Model.DescriptionArabic)
                                            </div>
                                        </div>

                                        <!--Tab Video-->
                                        @if (!string.IsNullOrWhiteSpace(Model.DemoFileName))
                                        {
                                            <div class="tab" id="prod-video">
                                                <h2 class="title">@Localizer["ProductVideo"]</h2>

                                                <section class="video-section style-two">
                                                    <div class="outer-box">
                                                        <div class="auto-container">
                                                            <div class="row">
                                                                <div class="video-column col-lg-12 col-md-12 col-sm-12">
                                                                    <div class="inner-column">
                                                                        <div class="video-box">
                                                                            <figure class="image">
                                                                                <img src="/CourseRoot/Image/@(Model.Image)" alt="@(Model.TitlePersian)">
                                                                                <a href="/CourseRoot/Demo/@(Model.DemoFileName)" class="link" data-fancybox="gallery" data-caption="">
                                                                                    <span class="icon fa fa-play"></span>
                                                                                </a>
                                                                            </figure>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </section>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <!--End Product Info Tabs-->

                        </div>
                    </div>
                </div>

                <!--Sidebar Side-->
                <partial name="Partials/_ProductFilterModalPartial" model="@ViewData["Categories"]" />

            </div>
        </div>
    </div>
</div>
