@using Toplearn.Core.DTOs.CourseVM
@model IEnumerable<CourseListAdminViewModel>
@using Toplearn.Web
@inject Microsoft.Extensions.Localization.IStringLocalizer<Resource> Localizer

@{
    ViewData["Title"] = "محصولات";
}

<div class="container">
    <div class="sidebar-page-container">
        <div class="auto-container">
            <div class="row clearfix" style="flex-direction: row-reverse;">

                <!-- Content Side -->
                <div class="content-side col-xl-9 col-lg-8 col-md-12">
                    <div class="our-shop">
                        <div class="row clearfix">

                            <!-- Shop Items -->
                            @foreach (var product in Model)
                            {
                                <!-- Shop Item -->
                                <div class="shop-item col-xl-4 col-lg-6 col-md-6 col-sm-12">
                                    <div class="inner-box">
                                        <div class="image">
                                            <img src="/CourseRoot/ThumbImage/@(product.Image)" alt="@(product.CourseTitle)" />
                                            <div class="overlay-box">
                                                <ul class="cart-option">
                                                    <li><a href="/product/@(product.CourseId)"><span class="fa fa-link"></span></a></li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="lower-content">
                                            <h3><a href="/product/@(product.CourseId)">@(product.CourseTitle)</a></h3>
                                            <div class="price">@* <span class="discount">$15.00</span> *@ @(product.Price) <span>تومان</span></div>
                                            <div class="clearfix">
                                                <div class="pull-left">
                                                    <a class="add-cart" href="#"><span class="fa fa-cart-plus"></span>@Localizer["AddToCart"]</a>
                                                </div>
                                                <div class="pull-right">
                                                    <!-- Rating -->
                                                    <div class="rating">
                                                        <span class="fa fa-star"></span>
                                                        <span class="fa fa-star"></span>
                                                        <span class="fa fa-star"></span>
                                                        <span class="fa fa-star"></span>
                                                        <span class="fa fa-star"></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>

                        <!-- Pagination -->
                        <div class="styled-pagination">
                            <ul class="clearfix">
                                <li class="prev-post"><a href="#"><span class="fa fa-long-arrow-left"></span> @Localizer["Prev"]</a></li>
                                <li><a href="#">1</a></li>
                                <li class="active"><a href="#">2</a></li>
                                <li><a href="#">3</a></li>
                                <li class="next-post"><a href="#"> @Localizer["Next"] <span class="fa fa-long-arrow-right"></span> </a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <partial name="Partials/_ProductFilterModalPartial" model="@ViewData["Categories"]"/>

            </div>
        </div>
    </div>
</div>
